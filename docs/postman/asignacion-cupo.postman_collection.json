    {
      "key": "clasesUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "rabbitUrl",
      "value": "http://localhost:15672"
    },
    {
      "key": "rabbitUser",
      "value": "gymtrack"
    },
    {
      "key": "rabbitPassword",
      "value": "gymtrack"
    },
    {
      "key": "colaEvidencia",
      "value": "gymtrack.cupo.evidencia.manual"
