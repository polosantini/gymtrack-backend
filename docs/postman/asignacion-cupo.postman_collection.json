    {
      "name": "04 - Verificar clase llena y una persona en espera",
      "request": {
        "method": "GET",
        "url": "{{clasesUrl}}/api/clases/{{claseId}}/reservas?fecha={{fecha}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado\",()=>pm.expect(pm.response.code).to.be.oneOf([200]));",
              "const r=pm.response.json();",
              "pm.test(\"Fixture lleno y una espera\",()=>{pm.expect(r.confirmados.length).to.eql(r.aforo);pm.expect(r.enEspera.length).to.eql(1);});",
              "if(r.enEspera.length){pm.collectionVariables.set(\"esperaId\",r.enEspera[0].id);pm.collectionVariables.set(\"miembroAviso\",r.enEspera[0].miembroId);}",
              "pm.collectionVariables.set(\"claseNombre\",r.claseNombre);pm.collectionVariables.set(\"hora\",r.hora);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Cancelar confirmada, publica Observer",
      "request": {
        "method": "PATCH",
        "url": "{{clasesUrl}}/api/reservas/{{reservaConfirmada}}/cancelar",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado\",()=>pm.expect(pm.response.code).to.be.oneOf([200]));",
              "pm.test(\"Cancelada\",()=>pm.expect(pm.response.json().estado).to.eql(\"CANCELADA\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Esperar asignación asíncrona y validar aforo",
      "request": {
        "method": "GET",
        "url": "{{clasesUrl}}/api/clases/{{claseId}}/reservas?fecha={{fecha}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado\",()=>pm.expect(pm.response.code).to.be.oneOf([200]));",
              "function validar(r){",
              " pm.test(\"Primera espera confirmada\",()=>pm.expect(r.confirmados.some(x=>x.id===Number(pm.collectionVariables.get(\"esperaId\")))).to.eql(true));",
              " pm.test(\"Sin sobreventa ni espera restante\",()=>{pm.expect(r.confirmados.length).to.eql(r.aforo);pm.expect(r.enEspera.length).to.eql(0);});",
              "}",
              "function buscar(intentos){pm.sendRequest(pm.variables.replaceIn(\"{{clasesUrl}}/api/clases/{{claseId}}/reservas?fecha={{fecha}}\"),(err,res)=>{",
              " if(err){pm.test(\"Consulta válida\",()=>{throw err;});return;}",
              " const r=res.json();if(r.confirmados.some(x=>x.id===Number(pm.collectionVariables.get(\"esperaId\")))){validar(r);return;}",
              " if(intentos<=0){validar(r);return;}setTimeout(()=>buscar(intentos-1),100);",
              "});}",
              "buscar(40);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Comprobar aviso exacto",
      "request": {
        "method": "POST",
        "url": "{{rabbitUrl}}/api/queues/%2F/{{colaEvidencia}}/get",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{rabbitUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{rabbitPassword}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"count\": 10,\n  \"ackmode\": \"ack_requeue_false\",\n  \"encoding\": \"auto\",\n  \"truncate\": 10000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado\",()=>pm.expect(pm.response.code).to.be.oneOf([200]));",
              "const mensajes=pm.response.json();pm.test(\"Un único aviso\",()=>pm.expect(mensajes.length).to.eql(1));",
              "if(mensajes.length===1){const m=mensajes[0],e=JSON.parse(m.payload);",
              " pm.test(\"Routing key y JSON\",()=>{pm.expect(m.routing_key).to.eql(\"reserva.cupo.asignado\");pm.expect(m.exchange).to.eql(\"gymtrack.events\");pm.expect(m.properties.content_type).to.eql(\"application/json\");pm.expect(m.properties.message_id).to.eql(\"reserva.cupo.asignado:\"+pm.collectionVariables.get(\"reservaConfirmada\"));});",
              " pm.test(\"Contrato exacto\",()=>{pm.expect(e).to.have.all.keys(\"miembroId\",\"claseNombre\",\"fecha\",\"hora\");pm.expect(e.miembroId).to.eql(Number(pm.collectionVariables.get(\"miembroAviso\")));pm.expect(e.claseNombre).to.eql(pm.collectionVariables.get(\"claseNombre\"));pm.expect(e.fecha).to.eql(pm.collectionVariables.get(\"fecha\"));pm.expect(e.hora).to.eql(pm.collectionVariables.get(\"hora\"));});",
              "}"
            ]
          }
        }
      ]
    },
