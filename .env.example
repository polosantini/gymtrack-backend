# Namespace GHCR en minusculas. En un fork, cambiar propietario/repositorio.
GHCR_NAMESPACE=polosantini/gymtrack-backend
# Esperar a que termine la publicacion de los tres servicios antes de usar latest.
# Para fijar una version: sha-<SHA completo del commit de main publicado>
IMAGE_TAG=latest
DB_USER=gymtrack
DB_PASSWORD=gymtrack
RABBIT_USER=gymtrack
RABBIT_PASSWORD=gymtrack
POSTGRES_PORT=5432
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MIEMBROS_PORT=8081
CLASES_PORT=8082
PAGOS_PORT=8083
